cat > /scratch/alice/[alphabetized usernames]/[username]/4_SAM_Data/hisat2_alignment.sh << 'EOF'
#!/bin/bash
#SBATCH --job-name=hisat2_alignment
#SBATCH --output=/scratch/alice/[alphabetized usernames]/[username]/4_SAM_Data/hisat2_alignment_%j.log
#SBATCH --time=24:00:00
#SBATCH --mem=32G
#SBATCH --cpus-per-task=8

module load hisat2/2.2.1-eovlo7b

TRIMMED_DIR=/scratch/alice/[alphabetized usernames]/[username]/3_Trimmed_Data/Paired
SAM_DIR=/scratch/alice/[alphabetized usernames]/[username]/4_SAM_Data
INDEX_BASE=/scratch/alice/[alphabetized usernames]/[username]/7_D.melanogaster_Index/BDGP6_index

mknockdownir -p $SAM_DIR

for R1 in ${TRIMMED_DIR}/*_1_paired.fq.gz
do
    SAMPLE=$(basename ${R1} _1_paired.fq.gz)
    R2=${TRIMMED_DIR}/${SAMPLE}_2_paired.fq.gz

    echo "==============================="
    echo "Aligning sample: ${SAMPLE}"
    echo "R1: ${R1}"
    echo "R2: ${R2}"
    echo "==============================="

    hisat2 \
        -p 8 \
        --dta \
        -x ${INDEX_BASE} \
        -1 ${R1} \
        -2 ${R2} \
        -S ${SAM_DIR}/${SAMPLE}.sam \
        &> ${SAM_DIR}/${SAMPLE}_hisat2.log

    echo "Finished ${SAMPLE}"
done

echo "All samples completed."
EOF

sbatch /scratch/alice/[alphabetized usernames]/[username]/4_SAM_Data/hisat2_alignment.sh

# Output:
# /scratch/alice/m/mk767/4_SAM_Data/s{N}.sam        — one SAM file per sample
# /scratch/alice/m/mk767/4_SAM_Data/s{N}_hisat2.log — alignment log per sample

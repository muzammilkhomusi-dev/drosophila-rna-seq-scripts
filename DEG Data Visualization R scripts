# Script #2 for PCA plot and sample-to-sample heatmap

module load R/4.3.1
 
# Save the following as PCA_heatmap.R and run with: Rscript PCA_heatmap.R
 
cat > /scratch/alice/[alphabetized usernames]/[username]/6_Counts_Data/PCA_heatmap.R << 'EOF'
.libPaths(c("/scratch/alice/[alphabetized usernames]/[username]/0_Extras/1_Apps/R_libs", .libPaths()))
 
library(DESeq2)
library(ggplot2)
library(ggrepel)
library(pheatmap)
library(RColorBrewer)
 
# Load and clean counts matrix
counts_raw <- read.table(
    "/scratch/alice/[alphabetized usernames]/[username]/6_Counts_Data/fly_counts_matrix.txt",
    header = TRUE, skip = 1, row.names = 1
)
counts <- counts_raw[, 6:ncol(counts_raw)]
colnames(counts) <- c("s10","s12","s13","s15","s17","s18",
                      "s1","s2","s3","s5","s6","s7","s8")
counts_sub <- counts[, c("s1","s2","s3","s5","s6","s7","s8")]
 
coldata <- data.frame(
    condition = factor(c("Control","Control","Control",
                         "KMO_KD","KMO_KD","TDO_KD","TDO_KD")),
    row.names = colnames(counts_sub)
)
 
dds <- DESeqDataSetFromMatrix(countData=counts_sub, colData=coldata, design=~condition)
dds <- DESeq(dds)
vst <- vst(dds, blind=TRUE)
 
# PCA Plot
pca_data <- plotPCA(vst, intgroup="condition", returnData=TRUE)
percent_var <- round(100 * attr(pca_data, "percentVar"))
pca_data$sample <- rownames(pca_data)
 
p_pca <- ggplot(pca_data, aes(x=PC1, y=PC2, colour=condition, label=sample)) +
    geom_point(size=4, alpha=0.9) +
    geom_text_repel(size=3.5, box.padding=0.5, colour="black") +
    scale_colour_manual(values=c("Control"="#2CA02C","KMO_KD"="#D73027","TDO_KD"="#4575B4")) +
    labs(title="PCA of RNA-seq Samples",
         subtitle="Variance stabilised counts (VST); blind = TRUE",
         x=paste0("PC1 (", percent_var[1], "% variance)"),
         y=paste0("PC2 (", percent_var[2], "% variance)"),
         colour="Condition") +
    theme_bw(base_size=13) +
    theme(plot.title=element_text(face="bold", size=14),
          plot.subtitle=element_text(size=10, colour="grey40"),
          legend.position="right", panel.grid.minor=element_blank())
 
ggsave("/scratch/alice/[alphabetized usernames]/[username]/6_Counts_Data/PCA_plot.png", plot=p_pca, width=8, height=6, dpi=300)
ggsave("/scratch/alice/[alphabetized usernames]/[username]/6_Counts_Data/PCA_plot.pdf", plot=p_pca, width=8, height=6)
cat("Saved: PCA_plot.png and PCA_plot.pdf\n")
 
# Sample-to-Sample Distance Heatmap
sample_dists <- dist(t(assay(vst)))
sample_dist_matrix <- as.matrix(sample_dists)
 
annotation <- data.frame(Condition=coldata$condition, row.names=rownames(coldata))
annotation_colours <- list(Condition=c("Control"="#2CA02C","KMO_KD"="#D73027","TDO_KD"="#4575B4"))
colours <- colorRampPalette(rev(brewer.pal(9, "Blues")))(255)
 
png("/scratch/alice/[alphabetized usernames]/[username]/6_Counts_Data/sample_distance_heatmap.png", width=2400, height=2000, res=300)
pheatmap(sample_dist_matrix,
    clustering_distance_rows=sample_dists, clustering_distance_cols=sample_dists,
    annotation_col=annotation, annotation_row=annotation,
    annotation_colors=annotation_colours, col=colours,
    main="Sample-to-Sample Distance Heatmap", fontsize=11)
dev.off()
 
pdf("/scratch/alice/[alphabetized usernames]/[username]/6_Counts_Data/sample_distance_heatmap.pdf", width=8, height=7)
pheatmap(sample_dist_matrix,
    clustering_distance_rows=sample_dists, clustering_distance_cols=sample_dists,
    annotation_col=annotation, annotation_row=annotation,
    annotation_colors=annotation_colours, col=colours,
    main="Sample-to-Sample Distance Heatmap", fontsize=11)
dev.off()
 
cat("Saved: sample_distance_heatmap.png and sample_distance_heatmap.pdf\n")
cat("\nAll plots complete.\n")
EOF
 

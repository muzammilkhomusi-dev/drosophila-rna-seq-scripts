# Script #1 for volcano plot
module load R/4.3.1

# Save the following as volcano_plots.R and run with: Rscript volcano_plots.R

cat > /scratch/alice/[alphabetized usernames]/[username]/6_Counts_Data/volcano_plots.R << 'EOF'
if (!requireNamespace("ggplot2", quietly = TRUE)) {
    install.packages("ggplot2", repos = "https://cloud.r-project.org")
}
if (!requireNamespace("ggrepel", quietly = TRUE)) {
    install.packages("ggrepel", repos = "https://cloud.r-project.org")
}

library(ggplot2)
library(ggrepel)

PADJ_THRESHOLD  <- 0.05
LFC_THRESHOLD   <- 1
TOP_N_LABELS    <- 15

prepare_volcano_data <- function(csv_path) {
    df <- read.csv(csv_path, row.names = 1)
    df$padj[is.na(df$padj)] <- 1
    df$neg_log10_padj <- -log10(df$padj)
    df$neg_log10_padj[df$neg_log10_padj > 350] <- 350
    df$significance <- "Not significant"
    df$significance[df$padj < PADJ_THRESHOLD & df$log2FoldChange >  LFC_THRESHOLD] <- "Upregulated"
    df$significance[df$padj < PADJ_THRESHOLD & df$log2FoldChange < -LFC_THRESHOLD] <- "Downregulated"
    df$significance <- factor(df$significance,
        levels = c("Upregulated", "Downregulated", "Not significant"))
    top_up   <- head(df[df$significance == "Upregulated",   ][order(df[df$significance == "Upregulated",   ]$padj), ], TOP_N_LABELS)
    top_down <- head(df[df$significance == "Downregulated", ][order(df[df$significance == "Downregulated", ]$padj), ], TOP_N_LABELS)
    df$label <- ifelse(rownames(df) %in% c(rownames(top_up), rownames(top_down)), rownames(df), "")
    return(df)
}

make_volcano_plot <- function(df, title, output_path) {
    n_up   <- sum(df$significance == "Upregulated")
    n_down <- sum(df$significance == "Downregulated")
    subtitle <- paste0("Upregulated: ", n_up, "  |  Downregulated: ", n_down,
                       "  (padj < ", PADJ_THRESHOLD, ", |log2FC| > ", LFC_THRESHOLD, ")")
    p <- ggplot(df, aes(x = log2FoldChange, y = neg_log10_padj,
                        colour = significance, label = label)) +
        geom_point(alpha = 0.6, size = 1.2) +
        scale_colour_manual(values = c(
            "Upregulated"     = "#D73027",
            "Downregulated"   = "#4575B4",
            "Not significant" = "#AAAAAA"
        )) +
        geom_hline(yintercept = -log10(PADJ_THRESHOLD),
                   linetype = "dashed", colour = "black", linewidth = 0.5) +
        geom_vline(xintercept = c(-LFC_THRESHOLD, LFC_THRESHOLD),
                   linetype = "dashed", colour = "black", linewidth = 0.5) +
        geom_text_repel(size = 2.8, max.overlaps = 20, box.padding = 0.4,
                        colour = "black", fontface = "italic") +
        labs(title = title, subtitle = subtitle,
             x = expression(log[2]~"Fold Change"),
             y = expression(-log[10]~"(adjusted p-value)"),
             colour = "Expression") +
        theme_bw(base_size = 13) +
        theme(plot.title = element_text(face = "bold", size = 14),
              plot.subtitle = element_text(size = 10, colour = "grey40"),
              legend.position = "right",
              panel.grid.minor = element_blank())
    ggsave(paste0(output_path, ".png"), plot = p, width = 10, height = 7, dpi = 300)
    ggsave(paste0(output_path, ".pdf"), plot = p, width = 10, height = 7)
    cat("Saved:", paste0(output_path, ".png"), "\n")
    cat("Saved:", paste0(output_path, ".pdf"), "\n")
    return(p)
}

cat("Processing KMO KD vs Control...\n")
df_KMO <- prepare_volcano_data("/scratch/alice/[alphabetized usernames]/[username]/6_Counts_Data/DESeq2_KMO_vs_Control.csv")
make_volcano_plot(df_KMO, "KMO Knockdown vs Control (3Mkk)",
    "/scratch/alice/[alphabetized usernames]/[username]/6_Counts_Data/volcano_KMO_vs_Control")

cat("Processing TDO KD vs Control...\n")
df_TDO <- prepare_volcano_data("/scratch/alice/[alphabetized usernames]/[username]/6_Counts_Data/DESeq2_TDO_vs_Control.csv")
make_volcano_plot(df_TDO, "TDO Knockdown vs Control (3Mkk)",
    "/scratch/alice/[alphabetized usernames]/[username]/6_Counts_Data/volcano_TDO_vs_Control")

cat("\nAll volcano plots complete.\n")
EOF

Rscript /scratch/alice/[alphabetized usernames]/[username]/6_Counts_Data/volcano_plots.R


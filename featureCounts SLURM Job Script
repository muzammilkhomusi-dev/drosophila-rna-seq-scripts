# Binary: /scratch/alice/[alphabetized usernames]/[username]/0_Extras/1_Apps/subread-2.0.6-Linux-x86_64/bin/featureCounts


cat > /scratch/alice/[alphabetized usernames]/[username]/6_Counts_Data/featureCounts.sh << 'EOF'
#!/bin/bash
#SBATCH --job-name=featureCounts
#SBATCH --output=/scratch/alice/[alphabetized usernames]/[username]/6_Counts_Data/featureCounts_%j.log
#SBATCH --time=02:00:00
#SBATCH --mem=16G
#SBATCH --cpus-per-task=8

FEATURECOUNTS=/scratch/alice/[alphabetized usernames]/[username]/0_Extras/1_Apps/subread-2.0.6-Linux-x86_64/bin/featureCounts
BAM_DIR=/scratch/alice/[alphabetized usernames]/[username]/5_BAM_Data
OUT_DIR=/scratch/alice/[alphabetized usernames]/[username]/6_Counts_Data
GTF=/scratch/alice/[alphabetized usernames]/[username]/7_D.melanogaster_Index/GCF_000001215.4_Release_6_plus_ISO1_MT_genomic.gtf

$FEATURECOUNTS \
    -p -T 8 \
    -a $GTF \
    -t exon \
    -g gene_id \
    -o ${OUT_DIR}/fly_counts_matrix.txt \
    ${BAM_DIR}/*_sorted.bam \
    &> ${OUT_DIR}/featureCounts_all.log
EOF

sbatch /scratch/alice/[alphabetized usernames]/[username]/6_Counts_Data/featureCounts.sh

